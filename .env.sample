# Copy to .env and fill in. .env is gitignored. Placeholders only in this file.

# --- Chainlink CRE ---
# Ethereum mainnet RPC is needed only for the onchain workflow registry (deploy step);
# Base Sepolia is the settlement chain.
ETH_MAINNET_RPC_URL=https://REPLACE_ME
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CRE_ETH_PRIVATE_KEY=0xREPLACE_ME_workflow_owner_key

# --- BlindOracle (public paid API, x402/USDC on Base) ---
# Register at https://api.craigmbrown.com/v1/agents/register to get an api_key.
BLINDORACLE_API_BASE=https://api.craigmbrown.com
BLINDORACLE_AGENT_A_API_KEY=REPLACE_ME
BLINDORACLE_AGENT_B_API_KEY=REPLACE_ME
# Optional starter-credit note accepted by the 402 challenge (instead of paying USDC)
BLINDORACLE_ECASH_TOKEN=

# --- Demo agents (Base Sepolia settlement wallets) ---
AGENT_A_PRIVATE_KEY=0xREPLACE_ME
AGENT_B_PRIVATE_KEY=0xREPLACE_ME

# --- Reserve prices are NOT env vars ---
# They are CRE Vault secrets (see secrets.yaml) so they only exist inside the enclave.
