# Copy to .env and fill in. .env is gitignored. Placeholders only in this file.

# --- Chainlink CRE ---
# Ethereum mainnet RPC is needed only for the onchain workflow registry (deploy step);
# Base Sepolia is the settlement chain.
ETH_MAINNET_RPC_URL=https://REPLACE_ME
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CRE_ETH_PRIVATE_KEY=0xREPLACE_ME_workflow_owner_key

# --- BlindOracle (public paid API, x402/USDC on Base MAINNET) ---
# No key is needed to pay: the wallet that signs the x402 challenge is the identity.
# bo_client.py pays from BLINDORACLE_PAYER_PRIVATE_KEY, else AGENT_A_PRIVATE_KEY, else
# CRE_ETH_PRIVATE_KEY. It needs USDC on Base (one bracket ≈ $0.52; a dispute is $5).
BLINDORACLE_API_BASE=https://api.craigmbrown.com
BLINDORACLE_PAYER_PRIVATE_KEY=
# Optional: api_keys from POST /v1/agents/register (free) — only needed for provider-side routes.
BLINDORACLE_AGENT_A_API_KEY=
BLINDORACLE_AGENT_B_API_KEY=

# --- Demo agents ---
# Agent A pays (Base mainnet USDC for BlindOracle; Base Sepolia ETH for settlement).
# Agent B is an identity only in this demo.
AGENT_A_PRIVATE_KEY=0xREPLACE_ME
AGENT_B_PRIVATE_KEY=0xREPLACE_ME

# --- Receiver deployment (scripts/deploy_receiver.py), optional overrides ---
# RECEIVER_FORWARDER=0xF8344CFd5c43616a4366C34E3EEE75af79a74482   # CRE Forwarder (production)
# RECEIVER_EXPECTED_OWNER=0x0000000000000000000000000000000000000000  # zero disables the owner check

# --- Reserve prices are NOT env vars ---
# They are CRE Vault secrets (see secrets.yaml) so they only exist inside the enclave.
