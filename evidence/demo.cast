[3.22483, "o", "\r\n"]
[3.224861, "o", "\t"]
[3.224884, "o", "seal: SealFn = sealBids,"]
[3.224911, "o", "\r\n"]
[3.224937, "o", "\t"]
[3.224962, "o", "write: WriteFn = writeSettlement,"]
[3.224989, "o", "\r\n"]
[3.225021, "o", "): string => {"]
[3.225046, "o", "\r\n"]
[3.225064, "o", "\t"]
[3.225084, "o", "const config = runtime.config"]
[3.225109, "o", "\r\n"]
[3.225137, "o", "\r\n"]
[3.225162, "o", "\t"]
[3.225201, "o", "// ONE getSecrets call for the whole execution (measured runtime limit:"]
[3.225264, "o", "\r\n"]
[6.734206, "o", "\r\n### t=2 The security property is a test suite — with deliberately leaky seals as negative controls\r\n\u001b[1;32m$\u001b[0m cd sealed-bid-ts && bun test 2>&1 | tail -6\r\n"]
