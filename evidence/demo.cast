[0.009948, "o", "\r\n### t=0 Sealed-Bid Agent Settlement — two agents, two private reserves, one enclave\r\n"]
[2.01286, "o", "\r\n### t=1 The enclave handler: cre.handlerInTee, ONE getSecrets call, overlap maths, salted commitments\r\n"]
[2.012902, "o", "\u001b[1;32m$\u001b[0m sed -n '/^export const sealBids/,/^}/p;/^export const runSealedBid/,/getSecrets/p' sealed-bid-ts/workflow.ts | head -30\r\n"]
[3.224125, "o", "export const sealBids: SealFn = (buyerMax, sellerMin) => {"]
[3.224295, "o", "\r\n"]
[3.224339, "o", "\t"]
[3.224384, "o", "if (buyerMax === null || sellerMin === null) return { result: 'INVALID_INPUT' }"]
[3.224417, "o", "\r\n"]
[3.22448, "o", "\t"]
[3.224514, "o", "if (sellerMin <= buyerMax) return { result: 'SETTLE', clearingPrice: (buyerMax + sellerMin) / 2 }"]
[3.224546, "o", "\r\n"]
[3.224574, "o", "\t"]
[3.224601, "o", "return { result: 'NO_OVERLAP' }"]
[3.224636, "o", "\r\n"]
[3.224665, "o", "}"]
[3.224691, "o", "\r\n"]
[3.224717, "o", "export const runSealedBid = ("]
[3.22475, "o", "\r\n"]
[3.224776, "o", "\t"]
